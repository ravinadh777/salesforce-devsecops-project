{"$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "Checkov", "version": "3.3.8", "informationUri": "https://checkov.io", "rules": [{"id": "CKV_GHA_7", "name": "The build output cannot be affected by user parameters other than the build entry point and the top-level source location. GitHub Actions workflow_dispatch inputs MUST be empty. ", "shortDescription": {"text": "The build output cannot be affected by user parameters other than the build entry point and the top-level source location. GitHub Actions workflow_dispatch inputs MUST be empty. "}, "fullDescription": {"text": "The build output cannot be affected by user parameters other than the build entry point and the top-level source location. GitHub Actions workflow_dispatch inputs MUST be empty. "}, "help": {"text": "The build output cannot be affected by user parameters other than the build entry point and the top-level source location. GitHub Actions workflow_dispatch inputs MUST be empty. \nResource: on(Enterprise Salesforce DevSecOps Security Orchestration Pipeline)"}, "defaultConfiguration": {"level": "error"}}, {"id": "CKV2_GHA_1", "name": "Ensure top-level permissions are not set to write-all", "shortDescription": {"text": "Ensure top-level permissions are not set to write-all"}, "fullDescription": {"text": "Ensure top-level permissions are not set to write-all"}, "help": {"text": "Ensure top-level permissions are not set to write-all\nResource: on(DevSecOps Pipeline)"}, "defaultConfiguration": {"level": "error"}}], "organization": "bridgecrew"}}, "results": [{"ruleId": "CKV_GHA_7", "ruleIndex": 0, "level": "error", "attachments": [], "message": {"text": "The build output cannot be affected by user parameters other than the build entry point and the top-level source location. GitHub Actions workflow_dispatch inputs MUST be empty. "}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": ".github/workflows/entriprise.yaml"}, "region": {"startLine": 12, "endLine": 22, "snippet": {"text": "      scan_depth:\n        description: 'Scan depth: quick | full | deep'\n        required: false\n        default: 'full'\n      target_env:\n        description: 'Target Salesforce org alias'\n        required: false\n        default: 'staging'\n\npermissions:\n  contents: write\n"}}}}]}, {"ruleId": "CKV2_GHA_1", "ruleIndex": 1, "level": "error", "attachments": [], "message": {"text": "Ensure top-level permissions are not set to write-all"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": ".github/workflows/finalcicd.yaml"}, "region": {"startLine": 1, "endLine": 1, "snippet": {"text": ""}}}}]}, {"ruleId": "CKV2_GHA_1", "ruleIndex": 1, "level": "error", "attachments": [], "message": {"text": "Ensure top-level permissions are not set to write-all"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": ".github/workflows/devsecops.yml"}, "region": {"startLine": 1, "endLine": 1, "snippet": {"text": ""}}}}]}]}]}